# Copy to .env and fill in. Never commit .env.

# Public hostname. Point its DNS A record at the VPS; Caddy fetches HTTPS automatically.
DOMAIN=dashboard.example.com

# The sign-in account, created on first start only (10+ characters).
# Change the password later in Settings, or with: docker compose exec api python manage.py set-password <username>
ADMIN_USERNAME=aretta
ADMIN_PASSWORD=
DISPLAY_NAME=Aretta

APP_ENV=production

# Optional: published Google Sheet CSV link used when the dashboard hasn't saved its own
DEFAULT_SHEET_URL=
AUTO_SYNC_ENABLED=true

# Set by scripts/deploy.sh on the VPS; "local" means images built on this machine.
REGISTRY=ghcr.io/benwhann
IMAGE_TAG=local
